# Скопируйте значения в переменные окружения хостинга. Сам файл .env в репозиторий не кладётся.
# Ключ авторизации GigaChat API (developers.sber.ru → проект GigaChat API → «Ключ авторизации»)
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Модель: GigaChat-2 (Lite) — по умолчанию
GIGACHAT_MODEL=GigaChat-2
# Любая длинная случайная строка, 30+ символов
SESSION_SECRET=
PORT=3000
